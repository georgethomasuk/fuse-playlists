{
  "manifest_version": 3,
  "name": "Fuse — Spotify bridge for Claude",
  "version": "0.4.0",
  "description": "Lets the Fuse music app (running inside a Claude artifact) talk to your Spotify account. Only runs on Claude.",
  "key": "",
  "permissions": ["identity", "storage"],
  "host_permissions": [
    "https://api.spotify.com/*",
    "https://accounts.spotify.com/*",
    "https://*.scdn.co/*",
    "https://*.spotifycdn.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": [
        "https://*.claudeusercontent.com/*",
        "https://claude.ai/*"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true,
      "run_at": "document_idle",
      "js": ["content.js"]
    }
  ]
}
